# Copy to .env and fill in:  cp .env.example .env
# Generate secrets with:      openssl rand -hex 24

# --- MLflow Auth Configurations ---
FLASK_SECRET_KEY=
# Admin is created on first start only; later changes here won't update the existing admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- RustFS / S3 Storage Configurations ---
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=mlflow-artifacts

# --- Postgres ---
DB_PASSWORD=
